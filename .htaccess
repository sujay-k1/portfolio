# Ensure sitemap is served with the correct MIME type
AddType text/xml .xml

# ---------------------------------------------------------------------------
# Gzip compression — reduces transfer size of text assets by ~70%
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2
    AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
</IfModule>

# ---------------------------------------------------------------------------
# Browser caching — return visitors skip re-downloading unchanged assets
# HTML: no-cache (always revalidate so page changes propagate immediately)
# CSS/JS: 1 month (sufficient window; change filenames to bust if needed)
# Images, video, fonts: 1 year (static assets that never change in-place)
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                  "access plus 0 seconds"
    ExpiresByType text/css                   "access plus 1 month"
    ExpiresByType application/javascript     "access plus 1 month"
    ExpiresByType text/javascript            "access plus 1 month"
    ExpiresByType image/jpeg                 "access plus 1 year"
    ExpiresByType image/png                  "access plus 1 year"
    ExpiresByType image/gif                  "access plus 1 year"
    ExpiresByType image/svg+xml              "access plus 1 year"
    ExpiresByType image/webp                 "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType video/mp4                  "access plus 1 year"
    ExpiresByType video/webm                 "access plus 1 year"
    ExpiresByType font/woff                  "access plus 1 year"
    ExpiresByType font/woff2                 "access plus 1 year"
    ExpiresByType application/font-woff      "access plus 1 year"
    ExpiresByType application/font-woff2     "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------------
# Security headers — improves Lighthouse Best Practices score
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?sujaykumar\.net$ [NC]
RewriteRule ^(.*)$ https://sujaykumar.net/$1 [L,R=301]
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?sujaykumar\.net$ [NC]
RewriteRule .* - [E=UPGRADE]
    <IfModule mod_headers.c>
        Header always set Content-Security-Policy "upgrade-insecure-requests;" env=UPGRADE
    </IfModule>
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On

# Legacy URL redirects
RewriteRule ^home\.html$ / [R=301,L,NC]
RewriteRule ^Work\.html$ /work [R=301,L,NC]
RewriteRule ^Work-Biz2X\.html$ /work/Biz2X [R=301,L,NC]
RewriteRule ^Work-Jio\.html$ /work/Jio [R=301,L,NC]
RewriteRule ^Work-MentorConnect\.html$ /work/MentorConnect [R=301,L,NC]
RewriteRule ^Work-Spillproof\.html$ /work/Spillproof [R=301,L,NC]
RewriteRule ^Work-SurakshaCentral\.html$ /work/SurakshaCentral [R=301,L,NC]
RewriteRule ^Work-WhatsApp\.html$ /work/WhatsApp [R=301,L,NC]
RewriteRule ^about/?$ / [R=301,L,NC]

# Canonical index routes
RewriteRule ^index\.html$ / [R=301,L,NC]
RewriteRule ^about/index\.html$ / [R=301,L,NC]
RewriteRule ^work/index\.html$ /work [R=301,L,NC]
RewriteRule ^work/Biz2X/index\.html$ /work/Biz2X [R=301,L,NC]
RewriteRule ^work/Jio/index\.html$ /work/Jio [R=301,L,NC]
RewriteRule ^work/MentorConnect/index\.html$ /work/MentorConnect [R=301,L,NC]
RewriteRule ^work/Spillproof/index\.html$ /work/Spillproof [R=301,L,NC]
RewriteRule ^work/SurakshaCentral/index\.html$ /work/SurakshaCentral [R=301,L,NC]
RewriteRule ^work/WhatsApp/index\.html$ /work/WhatsApp [R=301,L,NC]
</IfModule>
